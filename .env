# Server
PORT=5000
NODE_ENV=development

# MongoDB - Using local MongoDB by default
# For MongoDB Atlas, replace with your connection string:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/community-signal
MONGODB_URI=mongodb://127.0.0.1:27017/community-signal

# JWT
JWT_SECRET=community-signal-super-secret-key-2024
JWT_EXPIRES_IN=7d

# SMTP Email Configuration (for OTP)
# For Gmail: use smtp.gmail.com and an App Password
# For SendGrid: use smtp.sendgrid.net
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Community Signal" <noreply@communitysignal.app>
